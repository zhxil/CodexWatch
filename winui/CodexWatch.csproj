<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><UseWinUI>true</UseWinUI>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
  <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  <EnableMsixTooling>false</EnableMsixTooling><ApplicationManifest>app.manifest</ApplicationManifest>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>CodexWatch</AssemblyName><AssemblyTitle>Codex Watch</AssemblyTitle><Product>Codex Watch</Product><Description>Codex Watch quota monitor</Description>
 </PropertyGroup>
 <PropertyGroup><Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion><FileVersion>1.0.0.0</FileVersion></PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
  <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" PrivateAssets="all" />
  <Compile Include="..\CodexAppServerClient.cs" Link="Services\CodexAppServerClient.cs" />
 </ItemGroup>
 <Target Name="PublishXamlResources" AfterTargets="Publish">
  <PropertyGroup><Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion><FileVersion>1.0.0.0</FileVersion></PropertyGroup>
 <ItemGroup><XamlRuntimeResources Include="$(TargetDir)CodexWatch.pri;$(TargetDir)*.xbf" /></ItemGroup>
  <Copy SourceFiles="@(XamlRuntimeResources)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
 </Target>
</Project>
