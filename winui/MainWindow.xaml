<Window x:Class="CodexWatch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CodexWatch" Title="Codex Watch">
 <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  </Grid.Resources>
    <Grid Grid.Row="0" Margin="20,14,20,10" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
     <Button x:Name="BackButton" Grid.Column="0" Visibility="Collapsed" Click="Back_Click" AutomationProperties.Name="返回额度概览" ToolTipService.ToolTip="返回额度概览" Margin="0,0,4,0" Padding="8" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
     <StackPanel Grid.Column="1" x:Name="DragArea" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="PageTitle" Text="Codex Watch" FontWeight="SemiBold" FontSize="16"/></StackPanel>
     <ToggleButton x:Name="PinButton" Grid.Column="2" Click="Pin_Click" ToolTipService.ToolTip="固定为桌面悬浮面板" AutomationProperties.Name="固定为桌面悬浮面板" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE718;" FontSize="14"/></ToggleButton>
     <Button Grid.Column="3" Click="Settings_Click" ToolTipService.ToolTip="提醒设置" AutomationProperties.Name="提醒设置" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button>
     <Button Grid.Column="4" Click="Hide_Click" ToolTipService.ToolTip="收起至任务栏" AutomationProperties.Name="收起至任务栏" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
    </Grid>
  <ScrollViewer Grid.Row="1" x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" ZoomMode="Disabled" IsTabStop="True" AutomationProperties.Name="详情与提醒设置滚动区域">
   <StackPanel Spacing="16" Padding="20,8,20,12">
    <StackPanel x:Name="OverviewPanel" Spacing="12">

    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="额度概览" Style="{StaticResource Caption}"/><TextBlock x:Name="PlanText" Grid.Column="1" Style="{StaticResource Caption}" Text="等待连接"/></Grid>
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
     <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="本周额度" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="QuotaState" Grid.Column="1" Style="{StaticResource Caption}" Text="等待同步"/></Grid>
      <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
       <Grid Width="96" Height="96">
        <Viewbox Width="96" Height="96"><local:QuotaRing x:Name="WeeklyRing" AutomationProperties.Name="周额度剩余圆环"/></Viewbox>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="1"><TextBlock x:Name="WeeklyValue" Text="—" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="%" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <TextBlock Text="剩余额度" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
       </Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
        <TextBlock Text="下次自动重置" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="WeeklyReset" Text="等待同步" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="WeeklyCountdown" Text="等待重置时间" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
       </StackPanel>
      </Grid>
      <StackPanel x:Name="ShortSection" Spacing="6">
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="短周期剩余" Style="{StaticResource Caption}"/><TextBlock x:Name="ShortValue" Grid.Column="1" Text="—" FontWeight="SemiBold" FontSize="14"/></Grid>
       <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="ShortCountdown" Style="{StaticResource Caption}"/><TextBlock x:Name="ShortReset" Grid.Column="1" Style="{StaticResource Caption}"/></Grid>
      </StackPanel>
     </StackPanel>
    </Border>
    <Button x:Name="ResetCreditCard" Click="ResetCredits_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="查看手动重置失效时间" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
     <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel Spacing="4"><TextBlock Text="可用手动重置" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ResetCreditExpiry" Text="等待账户数据" FontSize="11" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
      <TextBlock x:Name="ResetCreditCount" Grid.Column="1" Text="—" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" ToolTipService.ToolTip="账户可手动使用的额外重置机会；使用请打开官方用量页"/>
      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </Grid>
    </Button>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
     <StackPanel Spacing="4"><TextBlock Text="今日 Token" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="TokenDetail" Text="本机统计 · 正在读取" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
     <TextBlock x:Name="TokenText" Grid.Column="1" Text="统计中" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </Grid>
    </StackPanel>
    <InfoBar x:Name="StatusBanner" IsOpen="False" IsClosable="False" Severity="Warning"/>
    <StackPanel x:Name="ResetCreditsPanel" Spacing="12" Visibility="Collapsed">
     <TextBlock x:Name="ResetCreditsSummary" Text="可用重置机会" FontSize="14" FontWeight="SemiBold"/>
     <StackPanel x:Name="ResetCreditsList" Spacing="10"/>
     <TextBlock Text="使用后会恢复额度并改变自动重置日期。请前往官方用量页面操作。" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
     <Button Content="打开官方用量页" Click="Usage_Click" HorizontalAlignment="Left"/>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Spacing="12" Visibility="Collapsed">
     <TextBlock Text="额度偏低和即将重置时提醒你" Style="{StaticResource Caption}"/>
     <ToggleSwitch x:Name="StartupToggle" Header="开机自动启动" Toggled="Startup_Toggled" AutomationProperties.Name="开机自动启动"/>
     <TextBlock x:Name="StartupStatus" Text="登录 Windows 后仅显示任务栏摘要" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
     <ToggleSwitch x:Name="AlertsToggle" Header="额度预警与重置提醒" IsOn="True"/>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <NumberBox x:Name="WarningBox" Header="偏低阈值（剩余 %）" Minimum="2" Maximum="99" Value="20" SpinButtonPlacementMode="Compact"/>
      <NumberBox x:Name="CriticalBox" Grid.Column="1" Header="耗尽阈值（剩余 %）" Minimum="1" Maximum="98" Value="10" SpinButtonPlacementMode="Compact"/>
     </Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <NumberBox x:Name="ResetBox" Header="重置前提醒（分钟）" Minimum="1" Maximum="1440" Value="15" SpinButtonPlacementMode="Compact"/>
      <NumberBox x:Name="RefreshBox" Grid.Column="1" Header="自动刷新（分钟）" Minimum="1" Maximum="60" Value="5" SpinButtonPlacementMode="Compact"/>
     </Grid>
     <NumberBox x:Name="ExpiryBox" Header="重置机会到期前提醒（小时）" Minimum="1" Maximum="168" Value="24" SpinButtonPlacementMode="Compact"/>
     <ToggleSwitch x:Name="QuietToggle" Header="夜间免打扰（23:00—08:00）" IsOn="True"/>
     <TextBlock Text="每个额度周期分别提醒，同一级别仅提醒一次。提醒需要程序保持运行，系统通知设置可能影响显示。" TextWrapping="Wrap" Style="{StaticResource Caption}"/>

    </StackPanel>

   </StackPanel>
  </ScrollViewer>
    <Grid x:Name="OverviewFooter" Grid.Row="2" Margin="20,10,20,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
     <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="SyncText" Text="等待首次同步" Style="{StaticResource Caption}"/><TextBlock x:Name="ModeText" Text="点击外部自动收起" Style="{StaticResource Caption}"/></StackPanel>
     <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" ToolTipService.ToolTip="立即刷新" AutomationProperties.Name="立即刷新"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
     <Button Grid.Column="2" Click="Usage_Click" ToolTipService.ToolTip="官方用量页面" AutomationProperties.Name="官方用量页面"><FontIcon Glyph="&#xE8A7;" FontSize="14"/></Button>
    </Grid>
  <StackPanel x:Name="SettingsFooter" Grid.Row="2" Margin="20,10,20,16" Visibility="Collapsed">
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存设置" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="测试提醒" Click="Test_Click"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
